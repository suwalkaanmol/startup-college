# Copy to hub/.env. Every setting the whole app needs lives here.
NODE_ENV=development
PORT=3000
JWT_SECRET=                    # 32+ random characters (required in production)

# Sign-in emails. Empty = test mode (the code is shown on screen).
SMTP_URL=                      # e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=UniHub <no-reply@example.com>
ALLOWED_DOMAIN=vitstudent.ac.in

# Travel: UniHub forwards /api and /socket.io to this server.
TRAVEL_API_URL=                # e.g. https://go2gether-api.onrender.com
TRAVEL_JWT_SECRET=             # same value as JWT_SECRET on the Travel server

# PG (PlaceMate)
PG_URL=https://placemate-x6pt.onrender.com
UNIHUB_SSO_SECRET=             # same value as UNIHUB_SSO_SECRET on PlaceMate

# Xerox (Supabase project URL and anon key; the anon key is safe to be public)
XEROX_SUPABASE_URL=
XEROX_SUPABASE_ANON_KEY=
