# Copy to hub/.env. Everything UniHub needs (Food, Xerox, Travel, PG, admin) runs from this one server.
NODE_ENV=development
PORT=3000
JWT_SECRET=                    # 32+ random characters (required in production)
DATA_FILE=                     # where accounts, orders and rides are saved (default hub/data/hub.json)

# Sign-in emails. Empty = test mode (the 6-digit code is shown on screen).
SMTP_URL=                      # e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=UniHub <no-reply@example.com>
ALLOWED_DOMAIN=vitstudent.ac.in

# Staff. In production the admin login uses this password; canteen and shop logins get
# random passwords, written once to first-run-logins.txt next to the data file.
ADMIN_PASSWORD=
