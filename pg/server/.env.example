NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/placemate
# Set true for hosted databases such as Neon
DATABASE_SSL=false
# 32+ characters, required in production
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
# e.g. smtps://user:pass@smtp-relay.brevo.com:465 (required in production)
SMTP_URL=
MAIL_FROM=PlaceMate <no-reply@example.com>
APP_ORIGIN=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=vitstudent.ac.in
CREDITS_PER_BOOKING=100
TERMS_VERSION=2026-10
# Used only by `npm test`. The database name must contain "test" because tests wipe it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/placemate_test

# UniHub sign-in: shared secret with the UniHub server (any long random string)
UNIHUB_SSO_SECRET=
# Test-student picker: always on in development; set true to allow it in production demos
ALLOW_DEV_LOGIN=false
