# --- required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# Must be the SAME secret the main app uses to sign its login tokens. At least 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend origin(s), no trailing slash. Comma-separate multiple (e.g. vercel URL + custom domain)
CLIENT_URL=http://localhost:5173

# --- optional ---
PORT=5000
# Set to "production" on Render
NODE_ENV=development

# Open access: the app opens without any sign-in (a profile is made per device). Set to "false" once the main app sends sign-in tokens.
ALLOW_GUESTS=true
